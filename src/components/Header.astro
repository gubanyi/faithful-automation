---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import { withBase } from '../utils/paths';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main">
		<a class="site-title" href={withBase('/')}>
			<svg viewBox="0 0 64 64" width="28" height="28" aria-hidden="true">
				<path d="M33 11v33h17z" />
				<path d="M30 17v27H16z" opacity="0.55" />
				<path class="hull" d="M11 47h42l-5 7H16z" />
			</svg>
			{SITE_TITLE}
		</a>
		<ul class="internal-links">
			{
				NAV_LINKS.map(({ href, label }) => (
					<li>
						<HeaderLink href={href}>{label}</HeaderLink>
					</li>
				))
			}
		</ul>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		column-gap: 1.5em;
		max-width: 1200px;
		margin: 0 auto;
	}
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.75em 0;
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
	}
	.site-title svg {
		flex-shrink: 0;
		fill: var(--accent);
	}
	.site-title .hull {
		fill: var(--warm);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.9em;
	}
	@media (max-width: 1000px) {
		nav {
			flex-direction: column;
		}
		.site-title {
			padding-bottom: 0;
		}
		.internal-links {
			justify-content: center;
		}
	}
</style>
