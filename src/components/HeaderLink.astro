---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../utils/paths';

type Props = HTMLAttributes<'a'> & { href: string };

const { href, class: className, ...props } = Astro.props;

// A link is active on its own page and on every page nested beneath it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstSegment = (path: string) => path.split('/').filter(Boolean)[0] ?? '';
const currentPath = Astro.url.pathname.slice(base.length);
const isCurrentPage = currentPath.replace(/\/$/, '') === href.replace(/\/$/, '');
const isActive = firstSegment(href) === firstSegment(currentPath);
---

<a
	href={withBase(href)}
	class:list={[className, { active: isActive }]}
	aria-current={isCurrentPage ? 'page' : isActive ? 'true' : undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		padding: 1em 0.5em;
		border-bottom: 4px solid transparent;
		color: rgb(var(--black));
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	a.active {
		border-bottom-color: var(--accent);
		font-weight: 700;
	}
	@media (max-width: 1000px) {
		a {
			padding: 0.5em 0.5em 0.6em;
		}
	}
</style>
