---
import { withBase } from '../../utils/paths';

interface Props {
	title: string;
	href?: string;
	eyebrow?: string;
}

const { title, href, eyebrow } = Astro.props;
---

<div class="card">
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<p class="title">
		{href ? <a href={withBase(href)}>{title}</a> : title}
	</p>
	<div class="body"><slot /></div>
</div>
<style>
	.card {
		position: relative;
		padding: 1em 1.25em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: #fff;
		transition:
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}
	.card:has(a:hover) {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.eyebrow {
		margin: 0;
		color: var(--accent);
		font-size: 0.7em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.title {
		margin: 0 0 0.35em;
		color: rgb(var(--black));
		font-size: 1.1em;
		font-weight: 700;
		line-height: 1.3;
	}
	.title a {
		color: inherit;
		text-decoration: none;
	}
	/* Make the whole card clickable. */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 12px;
	}
	.body {
		font-size: 0.85em;
		line-height: 1.55;
	}
	.body > :global(:last-child) {
		margin-bottom: 0;
	}
	.body :global(p) {
		margin: 0 0 0.5em;
	}
	.body :global(ol),
	.body :global(ul) {
		margin: 0;
		padding-left: 1.25em;
	}
	.body :global(li) {
		margin-bottom: 0.35em;
	}
</style>
